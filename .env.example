# Copy to .env (or export in your shell) and fill in.
# Without a key the app uses the built-in mock travel-time estimator.

# Google Maps Platform API key with the Routes API enabled.
# Setup: https://developers.google.com/maps/documentation/routes/cloud-setup
#GOOGLE_MAPS_API_KEY=

# Port for the web server (default 3000)
#PORT=3000

# Where the SQLite database is stored (default ./data)
#DATA_DIR=./data
